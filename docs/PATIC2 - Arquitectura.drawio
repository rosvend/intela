        <mxCell id="p3-pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;repertorio, titulares, splits, liquidaciones &#183; parametros normativos versionados con vigencia y organo aprobador&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="730" y="170" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-cola" value="&lt;b&gt;cola (pg-boss sobre PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;trabajos de matching y de reparto&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="730" y="310" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-obj" value="&lt;b&gt;almacen-objetos (MinIO / S3)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;reportes crudos inmutables y versionados &#183; RUT y certificacion bancaria&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="730" y="420" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-bit" value="&lt;b&gt;bitacora append-only&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;tabla sin UPDATE ni DELETE en postgres, mas copia inmutable en objetos. Retencion minima de 10 anos (R-13 &#183; RD 13.4 &#183; C.Co. 60)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="730" y="530" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p3-note" value="&lt;b&gt;api, scheduler y los workers son el mismo binario con distinto punto de entrada.&lt;/b&gt; El nucleo se compila una vez; lo que cambia es que adaptador de entrada se activa. Escalar el reparto es levantar mas replicas de worker-reparto, no partir el dominio en servicios (ADR 0003)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;fontColor=#3a5a37;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="880" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p3-ext" value="Sistemas externos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="110" width="440" height="500" as="geometry" />
        </mxCell>
        <mxCell id="p3-cisac" value="CISAC &#183; IDA (obras) e IPI (autores)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="1210" y="165" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-rating" value="Proveedor de rating por franja horaria" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="1210" y="235" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-banco" value="Banco &#183; dispersion de pagos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="1210" y="305" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-erp" value="ERP contable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="1210" y="375" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-smtp" value="Correo saliente &#183; la notificacion es un hecho juridico (RD 13.8.8)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="1210" y="445" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-redessys" value="REDES-SYS / AVSYS &#183; alcance por confirmar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;align=center;fontColor=#432d57;" vertex="1" parent="1">
          <mxGeometry x="1210" y="515" width="380" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p3-nube" value="&lt;b&gt;Camino a produccion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;br&gt;api, workers y scheduler &#8594; contenedores gestionados o funciones&lt;br&gt;postgres &#8594; base relacional gestionada con replica y backups&lt;br&gt;cola &#8594; servicio de mensajeria gestionado&lt;br&gt;almacen-objetos &#8594; bucket con versionado y bloqueo WORM&lt;br&gt;bitacora &#8594; el bloqueo WORM del bucket es lo que hace exigible el minimo de 10 anos&lt;br&gt;observabilidad &#8594; suite gestionada de logs, metricas y trazas&lt;br&gt;&lt;br&gt;&lt;i&gt;Ninguna de estas sustituciones toca el nucleo.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1180" y="650" width="440" height="230" as="geometry" />
        </mxCell>


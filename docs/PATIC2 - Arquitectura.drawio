  </diagram>

  <diagram id="intela-modulos" name="2 - Modulos del Dominio">
    <mxGraphModel dx="1900" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="Intela &#183; Modulos del Dominio y dependencias permitidas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#232f3e;" vertex="1" parent="1">
          <mxGeometry x="60" y="22" width="1780" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="Las flechas se leen &#171;depende de&#187;. La ausencia de flecha es tan informativa como su presencia: un modulo que no aparece apuntado no puede ser importado por el otro." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1780" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p2-afiliacion" value="&lt;b&gt;Afiliacion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Socio (honorario, fundador, activo) y Titular Administrado. Exclusividad de sociedad. Documentos de cobro.&lt;br&gt;&lt;br&gt;&lt;b&gt;Consulta punto-en-el-tiempo:&lt;/b&gt; solo reclama quien estaba afiliado al cierre del periodo.&lt;br&gt;&lt;br&gt;&lt;i&gt;solicitada &#8594; en estudio &#8594; inadmitida (10 dias habiles) &#8594; aprobada | rechazada &#8594; alta en registro&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-12 &#183; R-24 &#183; R-28 &#183; R-29 &#183; RS 4 &#183; RS 5.2 &#183; RD 14.5.5&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1140" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-repertorio" value="&lt;b&gt;Repertorio&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Obra (audiovisual, teatro, radio, nuevos medios), Declaracion de Obra y splits versionados. Filtro de repertorio por canal y por programa.&lt;br&gt;&lt;br&gt;&lt;b&gt;Unica fuente valida de porcentajes.&lt;/b&gt; Revision del Consejo con delegacion a comisiones.&lt;br&gt;&lt;br&gt;&lt;i&gt;declaracion_incompleta &#8594; valorizable&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-03 &#183; R-04 &#183; R-27 &#183; RD 7.1 &#183; RD 13.1.3 &#183; RS 3.1&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-recaudo" value="&lt;b&gt;Recaudo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Usuario, Convenio, tarifa pactada, factura, recargo por incumplimiento del 50%, pago recibido. Nacional e internacional gestionados por separado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Produce una bolsa por usuario y periodo. Es lo unico que sale de aqui.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;T-01 a T-11 &#183; RT 3 &#183; RT 5 &#183; R-35 &#183; RD 10.3&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1320" y="120" width="420" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p2-legend" value="&lt;b&gt;Como leer este diagrama&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;br&gt;&#9632; naranja &#8212; modulo de dominio con sus invariantes&lt;br&gt;&#9632; gris punteado &#8212; concern transversal al nucleo&lt;br&gt;&#9632; azul &#8212; nota de diseno, no es un modulo&lt;br&gt;&lt;br&gt;&#8594; flecha llena: dependencia de codigo, en tiempo de compilacion&lt;br&gt;&#8594; flecha punteada: dependencia de solo lectura sobre una proyeccion&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-ingesta" value="&lt;b&gt;Ingesta y Normalizacion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;adaptadores de adquisicion, boveda de reportes crudos inmutables y versionados con su huella SHA-256, esquema canonico y log de rechazos con motivo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ningun reporte trae importes.&lt;/b&gt; Lo que sale de aqui pondera la bolsa; nunca la constituye.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;KR-1 &#183; OE-1 &#183; ADR 0005 &#183; fuentes-datos.md&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="100" y="370" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-x14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-identificacion" target="p2-ingesta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-identificacion" value="&lt;b&gt;Identificacion de Obras&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cascada de resolucion, tabla alias_obra, cola de resolucion manual con evidencia adjunta, emision de ONI.&lt;br&gt;&lt;br&gt;&lt;b&gt;No escribe titulares ni porcentajes y no toca dinero.&lt;/b&gt; Los campos Autor* y Guionista* de una parrilla entran aqui como features, nunca como insumo de pago.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-02 &#183; RD 7.3.3 &#183; identificadores.md&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="560" y="370" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-noterecaudo" value="&lt;b&gt;Por que Recaudo esta aislado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;br&gt;Recaudo es el unico modulo que conoce Usuario, Convenio y Tarifa. Aguas abajo solo circula una &lt;b&gt;bolsa&lt;/b&gt; por usuario y periodo.&lt;br&gt;&lt;br&gt;Ese corte es lo que hace imposible el error de sumar dinero por fila de un reporte de uso: los reportes entran por Identificacion, que no tiene importes que sumar.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="1320" y="370" width="420" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p2-noteausencias" value="&lt;b&gt;Ausencias deliberadas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;br&gt;&#183; &lt;b&gt;Repertorio y Recaudo no conocen a Reparto.&lt;/b&gt; Se puede cambiar el motor de reparto sin tocar el catalogo ni la facturacion.&lt;br&gt;&#183; &lt;b&gt;Identificacion no conoce a Reparto ni a Liquidacion.&lt;/b&gt; Reconocer una obra y pagarla son problemas separados.&lt;br&gt;&#183; &lt;b&gt;Reparto no conoce tarifas ni usuarios.&lt;/b&gt; Recibe una bolsa ya deducida.&lt;br&gt;&#183; &lt;b&gt;Ningun modulo escribe en Trazabilidad de otro.&lt;/b&gt; Cada uno publica su propio asiento.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="560" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p2-reparto" value="&lt;b&gt;Reparto&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Deducciones legales (hasta 20% administrativo, hasta 10% social) y reserva &#8594; valorizacion por puntos segun modalidad &#8594; valor punto &#8594; importe de obra &#8594; importe por titular.&lt;br&gt;&lt;br&gt;Un calculador por modalidad: TV abierta, cine, teatro, transporte, TV por suscripcion, hoteles, OTT.&lt;br&gt;&lt;br&gt;&lt;b&gt;Las deducciones se practican sobre la bolsa, antes de ponderar entre obras.&lt;/b&gt; Los rendimientos financieros se suman despues.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-06 &#183; RD 11 &#183; RD 9.1-9.7 &#183; RD 10&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=14;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="740" y="620" width="620" height="220" as="geometry" />
        </mxCell>

        <mxCell id="p2-oni" value="&lt;b&gt;ONI y Prescripcion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;listado publico con titulos e informacion identificatoria y &lt;b&gt;sin montos&lt;/b&gt;. Reserva del 5% con su vector de proporciones.&lt;br&gt;&lt;br&gt;ONI prescribe a los 3 anos desde la publicacion; el general a los 10 desde la notificacion.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-07 &#183; R-18 &#183; R-19 &#183; R-20 &#183; RD 14.4&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-liquidacion" value="&lt;b&gt;Liquidacion y Pago&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;proyecto de reparto, notificacion con acuse, orden de pago. Minima cuantia del 2% de un SMMLV que se arrastra al periodo siguiente.&lt;br&gt;&lt;br&gt;&lt;i&gt;emitida &#8594; notificada &#8594; aceptada por silencio a los 15 dias &#8594; pagada&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-10 &#183; R-11 &#183; R-12 &#183; RD 13.8.8&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="760" y="900" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-anticipos" value="&lt;b&gt;Anticipos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;solo Socios. Tope del 25% de lo generado en los repartos ordinarios de los ultimos dos anos y nunca mas de 5 SMMLV. Un solo anticipo vigente.&lt;br&gt;&lt;br&gt;&lt;b&gt;Se descuenta automaticamente de los repartos futuros.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-30 &#183; R-31 &#183; R-32 &#183; R-33 &#183; RA 3&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1360" y="900" width="380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p2-reclamaciones" value="&lt;b&gt;Reclamaciones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;respuesta individual y por escrito en 15 dias habiles. No se atienden errores de la propia declaracion, ni reclamos de quien no estaba afiliado, ni de autores de sociedades hermanas por via directa.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-22 &#183; R-23 &#183; R-24 &#183; R-25 &#183; RD 14.3&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="760" y="1160" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p2-noteestados" value="&lt;b&gt;Estados de primera clase&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;br&gt;Ninguno de estos es un error ni un flag de excepcion. Son estados validos del modelo y el sistema debe poder quedarse en ellos indefinidamente:&lt;br&gt;&lt;br&gt;&#183; &lt;b&gt;declaracion_incompleta&lt;/b&gt; &#8212; retiene el total, nunca prorratea&lt;br&gt;&#183; &lt;b&gt;oni&lt;/b&gt; &#8212; obra comunicada sin autor identificado&lt;br&gt;&#183; &lt;b&gt;en_reserva&lt;/b&gt; &#8212; con su vector de proporciones&lt;br&gt;&#183; &lt;b&gt;prescrito&lt;/b&gt; &#8212; a favor de REDES SGC&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="100" y="370" width="380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p2-traz" value="&lt;b&gt;Trazabilidad&lt;/b&gt; (transversal) &#8212; todos los modulos publican asientos aqui; ninguno lee los de otro.&lt;br&gt;&lt;font style='font-size:10px'&gt;linaje por cifra hasta fuente, reporte y regla aplicada &#183; snapshot de parametros y version de reglamento por corrida &#183; retencion minima de 10 anos &#183; RD 13.4 &#183; RD 16 &#183; R-13&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=13;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="100" y="1390" width="1640" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-apr" value="&lt;b&gt;Aprobaciones y Doble Control&lt;/b&gt; (transversal) &#8212; compuerta obligatoria en cada punto donde sale dinero.&lt;br&gt;&lt;font style='font-size:10px'&gt;aval de Revisoria Fiscal y de Distribucion y contabilidad (RD 14.5.10-12) &#183; pagos al exterior (RD 13.6) &#183; ONI con aval de Contabilidad (RD 13.8.6) &#183; anticipos con acta y resolucion del Consejo Directivo (RA 3.2)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=13;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="100" y="1500" width="1640" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p2-lane" value="Los dos procesos de distribucion del RD 13.5 &#8212; cada etapa tiene dueno nombrado en el reglamento, y las compuertas de Aprobaciones caen en Verificacion y en Pago y Registro" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b3b3b3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">

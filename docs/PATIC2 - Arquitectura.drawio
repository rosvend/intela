        <mxCell id="p3-sub" value="Unica pagina con tecnologia concreta (ADR 0009). El nucleo de la pagina 1 no sabe nada de lo que hay aqui: cambiar cualquiera de estas cajas es cambiar un adaptador." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">

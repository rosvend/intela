<mxfile host="app.diagrams.net" agent="Intela architecture" version="24.0.0">
  <diagram id="intela-hexagonal" name="1 - Arquitectura Hexagonal">
    <mxGraphModel dx="2480" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1-title" value="Intela &#183; Arquitectura Hexagonal (Puertos y Adaptadores) &#183; REDES SGC" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#232f3e;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="2340" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" value="El nucleo no nombra ningun adaptador. Toda travesia de la frontera pasa por un puerto, y la dependencia siempre apunta hacia adentro. Las citas (R-xx, RD/RT/RS/RA x.y) remiten a docs/dominio/reglas-negocio.md y docs/reglamentos/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="2340" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p1-band1" value="ADAPTADORES DE ENTRADA (driver / primarios)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b3b3b3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="400" height="800" as="geometry" />
        </mxCell>
        <mxCell id="p1-band2" value="PUERTOS DE ENTRADA&#10;(casos de uso)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b3b3b3;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="210" height="800" as="geometry" />
        </mxCell>
        <mxCell id="p1-band3" value="NUCLEO &#183; sin una sola dependencia hacia afuera" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3a5a37;" vertex="1" parent="1">
          <mxGeometry x="710" y="110" width="1060" height="800" as="geometry" />
        </mxCell>
        <mxCell id="p1-band4" value="PUERTOS DE SALIDA&#10;(driven)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b3b3b3;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1800" y="110" width="210" height="800" as="geometry" />
        </mxCell>
        <mxCell id="p1-band5" value="ADAPTADORES DE SALIDA (driven / secundarios)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b3b3b3;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="2040" y="110" width="340" height="800" as="geometry" />
        </mxCell>

        <mxCell id="p1-a1" value="&lt;b&gt;Portal del Titular&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;web / movil &#183; liquidaciones y origen de cada cifra&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-a2" value="&lt;b&gt;Consola Administrativa&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cola manual &#183; revision de declaraciones con delegacion a comisiones (RS 3.1)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="255" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-a3" value="&lt;b&gt;Portal de Auditoria&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;solo lectura &#183; Revisor Fiscal y DNDA, en cualquier tiempo (RD 16)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-a4" value="&lt;b&gt;Webhooks Externos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;confirmacion de dispersion &#183; avisos de sociedades hermanas&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="435" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-gw" value="&lt;b&gt;API Gateway (REST)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;autenticacion &#183; cuotas &#183; versionado&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#b1cdf0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="165" width="90" height="345" as="geometry" />
        </mxCell>
        <mxCell id="p1-a5" value="&lt;b&gt;Cargador de Reportes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CSV / XLSX / JSON &#183; parrillas, OTT, recaudo&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-a6" value="&lt;b&gt;Planificador de Procesos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;consulta el CalendarioDeDistribucion del dominio &#183; no es dueno del reloj (RD 12)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1-a7" value="&lt;b&gt;CLI de Operaciones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reproceso y verificacion de una corrida&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1f3350;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="250" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p1-pi0" value="&lt;b&gt;Afiliacion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;RegistrarAfiliado&lt;br&gt;VerificarExclusividadDeSociedad&lt;br&gt;MantenerPadronIPI&lt;br&gt;RegistrarDocumentosDeCobro&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="165" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi1" value="&lt;b&gt;Declaracion de Obra&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;RegistrarDeclaracionDeObra&lt;br&gt;RevisarDeclaracionDeObra&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="258" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi2" value="&lt;b&gt;Servicios al Socio&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;SolicitarAnticipo&lt;br&gt;RadicarReclamacion&lt;br&gt;ExplicarCifra&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="351" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi3" value="&lt;b&gt;Recaudo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;RegistrarRecaudo&lt;br&gt;EmitirFactura&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="444" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi4" value="&lt;b&gt;Ingesta y Reconocimiento&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;CargarReporteDeUso&lt;br&gt;EjecutarIdentificacionDeObras&lt;br&gt;ResolverCoincidenciaManual&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="537" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi5" value="&lt;b&gt;Proceso de Reparto&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;AbrirProcesoDeReparto&lt;br&gt;AvanzarEtapaDeReparto&lt;br&gt;AprobarEtapa &#183; GenerarLiquidaciones&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="630" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi6" value="&lt;b&gt;Pago y Notificacion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;NotificarProyectoDeReparto&lt;br&gt;EmitirOrdenDePago&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="723" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi7" value="&lt;b&gt;Ciclo del Dinero Retenido&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;PublicarListadoONI&lt;br&gt;AplicarPrescripciones&lt;br&gt;LiberarReserva&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="816" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p1-app" value="Capa de Aplicacion &#183; casos de uso, orquestacion, limites de transaccion &#183; &lt;font style='font-size:11px;font-weight:normal'&gt;depende del Dominio, nunca al reves&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3a5a37;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="1020" height="740" as="geometry" />
        </mxCell>
        <mxCell id="p1-orq" value="&lt;b&gt;Orquestador de Procesos de Reparto&lt;/b&gt; &#8212; dos maquinas de estado, no una con un if (RD 13.5)&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Nacional:&lt;/b&gt; Recaudo &#8594; Deducciones &#8594; Importe de la Obra &#8594; Importe por Titular &#8594; Liq. Parcial &#8594; Verificacion &#8594; Liq. Final &#8594; Pago y Registro &#8594; Auditoria&lt;br&gt;&lt;b&gt;Internacional:&lt;/b&gt; Recaudo &#8594; Deducciones &#8594; Liq. Parcial &#8594; Verificacion &#8594; Liq. Final &#8594; Pago y Registro &#8594; Fees in Error &#8594; Auditoria&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;El camino internacional no tiene valorizacion: se reparte tal como lo discrimino la sociedad hermana, sin modificar &#183; RD 7.4&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;fontColor=#3a5a37;" vertex="1" parent="1">
          <mxGeometry x="750" y="195" width="980" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p1-dom" value="Dominio &#183; entidades, invariantes y calculo puro (sin E/S)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="750" y="340" width="980" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p1-d1" value="&lt;b&gt;Motor de Identificacion de Obras&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cascada: alias conocido &#8594; identificador global (IDA / EIDR / IMDB) &#8594; difuso sobre titulo &#8594; cola de resolucion manual.&lt;br&gt;&lt;br&gt;Escribe alias_obra y emite ONI. &lt;b&gt;No toca dinero.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-02 &#183; RD 7.3.3 &#183; identificadores.md&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="770" y="382" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-d2" value="&lt;b&gt;Motor de Reparto&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;funcion pura de (bolsa, reportes normalizados, snapshot de parametros, declaraciones vigentes). Un calculador por modalidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;Deducciones y reserva ANTES de ponderar.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;RD 11 &#183; RD 9.1-9.7 &#183; R-06&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1090" y="382" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-d3" value="&lt;b&gt;Liquidacion y Pago&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;aceptacion por silencio a los 15 dias &#183; minima cuantia 2% SMMLV que se arrastra al periodo siguiente &#183; recoupment automatico del anticipo &#183; RUT y certificacion bancaria&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-10 &#183; R-11 &#183; R-12 &#183; R-33&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1410" y="382" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-d4" value="&lt;b&gt;Repertorio y Titularidad&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Obra, Declaracion de Obra, splits, Titular (IPI, persona natural).&lt;br&gt;&lt;br&gt;&lt;b&gt;Invariante: la suma declarada es 100% o la obra queda en declaracion_incompleta.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-01 &#183; R-03 &#183; R-04 &#183; RD 13.1.3&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="770" y="560" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-d5" value="&lt;b&gt;Reserva, ONI y Prescripcion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reserva hasta 5% del recaudo nacional, extraida semestralmente, que guarda el &lt;b&gt;vector de proporciones&lt;/b&gt; de la distribucion de la que salio &#183; ONI 3 anos &#183; general 10 anos&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-07 &#183; RD 14.4 &#183; R-19 &#183; R-20&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1090" y="560" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-d6" value="&lt;b&gt;Trazabilidad&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;asiento append-only. Cada peso guarda su linaje hasta la fuente, el reporte y la regla aplicada.&lt;br&gt;&lt;br&gt;Cada corrida fija su &lt;b&gt;snapshot de parametros y version de reglamento&lt;/b&gt;.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#7f7f7f'&gt;&lt;i&gt;R-13 &#183; RD 13.4 &#183; RD 16&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=8;fontColor=#7a5300;" vertex="1" parent="1">
          <mxGeometry x="1410" y="560" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-apr" value="&lt;b&gt;Aprobaciones y Doble Control&lt;/b&gt; &#8212; ninguna salida de dinero se autoriza con una sola firma&lt;br&gt;&lt;font style='font-size:10px'&gt;aval de Revisoria Fiscal &lt;b&gt;y&lt;/b&gt; de Distribucion y contabilidad (RD 14.5.10-12) &#183; pagos al exterior avalados por documentacion, distribucion y contabilidad (RD 13.6) &#183; ONI controlado por Distribucion y Gerencia con aval de Contabilidad (RD 13.8.6) &#183; anticipos con acta y resolucion individual del Consejo Directivo (RA 3.2)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;fontColor=#3a5a37;" vertex="1" parent="1">
          <mxGeometry x="750" y="760" width="980" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p1-po1" value="&lt;b&gt;Persistencia&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;RepositorioObras&lt;br&gt;RepositorioTitulares&lt;br&gt;RepositorioRecaudo&lt;br&gt;RepositorioReparto&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1815" y="180" width="180" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-po2" value="&lt;b&gt;Catalogos Externos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;PuertoCatalogoInternacional&lt;br&gt;(IDA obras / IPI autores)&lt;br&gt;PuertoProveedorRating&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1815" y="300" width="180" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-po3" value="&lt;b&gt;Dinero&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;PuertoDispersionDePagos&lt;br&gt;PuertoContabilidad&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1815" y="420" width="180" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-po4" value="&lt;b&gt;Comunicacion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;PuertoNotificaciones&lt;br&gt;&lt;i&gt;devuelve acuse persistible:&lt;br&gt;arranca el reloj de prescripcion&lt;br&gt;RD 13.8.8&lt;/i&gt;&lt;br&gt;PuertoBusEventos&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1815" y="540" width="180" height="105" as="geometry" />
        </mxCell>
